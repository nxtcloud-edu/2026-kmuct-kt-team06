{
  "version": "v1",
  "hooks": [
    {
      "name": "board-gate",
      "trigger": "PreToolUse",
      "action": { "type": "command", "command": "$HOME/.kiro/skills/board/gate_hook.sh" },
      "timeout": 15
    },
    {
      "name": "board-auto-report",
      "trigger": "AgentStop",
      "action": { "type": "command", "command": "$HOME/.kiro/skills/board/auto_report.sh" },
      "timeout": 15
    }
  ]
}
